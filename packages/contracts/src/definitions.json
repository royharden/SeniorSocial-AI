{
  "Problem": {
    "description": "RFC 9457 problem detail. Never leaks another organisation's data.",
    "type": "object",
    "required": [
      "type",
      "title",
      "status"
    ],
    "properties": {
      "type": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "status": {
        "type": "integer"
      },
      "detail": {
        "type": "string"
      },
      "instance": {
        "type": "string"
      },
      "human_route": {
        "type": "string",
        "description": "What the person can do instead - present on AiDisabled"
      }
    }
  },
  "PageMeta": {
    "type": "object",
    "properties": {
      "next_cursor": {
        "type": [
          "string",
          "null"
        ]
      },
      "total_known": {
        "type": "boolean",
        "description": "false when the count is an estimate - never present a guess as a count"
      }
    }
  },
  "Org": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "locale_default": {
        "type": "string"
      }
    }
  },
  "Me": {
    "type": "object",
    "required": [
      "user_id",
      "org_id",
      "roles",
      "mode",
      "locale"
    ],
    "properties": {
      "user_id": {
        "type": "string",
        "format": "uuid"
      },
      "org_id": {
        "type": "string",
        "format": "uuid"
      },
      "roles": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "senior",
            "caregiver",
            "staff",
            "admin",
            "partner",
            "support"
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "mode": {
        "type": "string",
        "enum": [
          "standard",
          "easy"
        ]
      },
      "locale": {
        "type": "string",
        "enum": [
          "en",
          "es"
        ]
      },
      "acting_for": {
        "type": [
          "string",
          "null"
        ],
        "format": "uuid",
        "description": "set when a caregiver is acting under consent"
      },
      "active_scopes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "display_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "preferences": {
        "$ref": "#/components/schemas/Preferences"
      },
      "consent_version": {
        "type": "integer",
        "minimum": 1
      },
      "demo_mode": {
        "type": "boolean"
      },
      "profile_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "additionalProperties": false
  },
  "Session": {
    "type": "object",
    "properties": {
      "user_id": {
        "type": "string",
        "format": "uuid"
      },
      "expires_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "additionalProperties": false
  },
  "User": {
    "type": "object",
    "required": [
      "version"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "org_id": {
        "type": "string",
        "format": "uuid"
      },
      "display_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "roles": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "senior",
            "caregiver",
            "staff",
            "admin",
            "partner",
            "support"
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "account_state": {
        "type": "string",
        "enum": [
          "active",
          "held_for_review",
          "deactivated"
        ]
      },
      "version": {
        "type": "integer",
        "minimum": 1,
        "description": "Current optimistic-concurrency version returned to admin clients"
      }
    },
    "additionalProperties": false
  },
  "UserPatch": {
    "type": "object",
    "required": [
      "expected_version"
    ],
    "properties": {
      "roles": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "senior",
            "caregiver",
            "staff",
            "admin",
            "partner",
            "support"
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "account_state": {
        "type": "string"
      },
      "expected_version": {
        "type": "integer",
        "minimum": 1,
        "description": "Must match the current User.version; stale writes return 409"
      }
    },
    "additionalProperties": false
  },
  "UserPage": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/User"
        }
      },
      "meta": {
        "$ref": "#/components/schemas/PageMeta"
      }
    }
  },
  "Profile": {
