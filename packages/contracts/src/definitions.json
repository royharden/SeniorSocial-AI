        "type": [
          "string",
          "null"
        ]
      },
      "contact_phone": {
        "type": [
          "string",
          "null"
        ]
      },
      "accessibility_conditions": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "structured",
        "optional": null,
        "never required to save": null
      }
    },
    "additionalProperties": false
  },
  "ProfilePatch": {
    "type": "object",
    "description": "partial Profile"
  },
  "Preferences": {
    "type": "object",
    "required": [
      "mode",
      "locale",
      "channels",
      "quiet_hours",
      "no_outbound"
    ],
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "standard",
          "easy"
        ]
      },
      "locale": {
        "type": "string",
        "enum": [
          "en",
          "es"
        ]
      },
      "channels": {
        "type": "object",
        "description": "per notice-purpose channel choice - a required task notice is independent of unrelated opt-ins"
      },
      "quiet_hours": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "no_outbound": {
        "type": "boolean",
        "description": "when true no outbound job is created at all"
      },
      "shared_device": {
        "type": "boolean",
        "description": "suppresses sender and preview detail on shared phones"
      }
    },
    "additionalProperties": false
  },
