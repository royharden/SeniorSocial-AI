  "RideRequest": {
    "type": "object",
    "required": [
      "id",
      "state",
      "org_id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "org_id": {
        "type": "string",
        "format": "uuid"
      },
      "purpose": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": [
          "paratransit",
          "taxi_voucher",
          "rideshare",
          "partner_van"
        ]
      },
      "pickup_at": {
        "type": "string",
        "format": "date-time"
      },
      "pickup_location": {
        "type": "string"
      },
      "return_needed": {
        "type": "boolean"
      },
      "accessibility_conditions": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "preserved verbatim through every handoff"
      },
      "accessibility_details": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "label"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          },
          "additionalProperties": false
        },
        "description": "structured code plus the exact resident-entered label"
      },
      "state": {
        "type": "string",
        "enum": [
          "draft",
          "requested",
          "waiting_for_dispatcher",
          "confirmed_by",
          "completed",
          "cancelled",
          "unable_to_fulfill"
        ]
      },
      "confirmed_by_actor": {
        "type": [
          "string",
          "null"
        ]
      },
      "confirmed_at": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "send_state": {
        "type": "string",
        "enum": [
          "not_sent",
          "sent",
          "send_failed"
        ],
        "description": "a failed send leaves the request saved and unsent",
        "never booked": null
      }
    }
  },
  "RideRequestInput": {
    "type": "object",
    "properties": {
      "accessibility_conditions": {
        "type": "array",
        "items": {
          "type": "string"
        },
