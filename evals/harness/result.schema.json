{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seniorsocial/evals/result.schema.json",
  "x_schema_version": "1.1",
  "title": "SeniorSocial deterministic stub eval result v1.1 (LOCKED)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "mode", "provider", "network_calls", "billable_tokens", "cost_usd", "cases", "summary"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "run_id": { "type": "string", "pattern": "^stub-[a-f0-9]{16}$" },
    "mode": { "const": "stub" },
    "provider": { "const": "stub" },
    "network_calls": { "const": 0 },
    "billable_tokens": { "const": 0 },
    "cost_usd": { "const": 0 },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "source", "package_id", "floor_group", "must_pass", "status", "score", "provider", "model", "external_calls", "billable_tokens", "cost_usd", "assertions"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^EV-[a-z0-9-]+-[0-9]{2}$" },
          "source": { "type": "string", "minLength": 1 }, "package_id": { "type": "string", "pattern": "^WP-[0-9]+$" },
          "floor_group": { "type": "string", "minLength": 1 }, "must_pass": { "type": "boolean" },
          "status": { "enum": ["pass", "fail", "abstain", "not_run"] }, "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "provider": { "const": "stub" }, "model": { "type": "string", "minLength": 1 },
          "external_calls": { "const": 0 }, "billable_tokens": { "const": 0 }, "cost_usd": { "const": 0 },
          "assertions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["grader", "passed", "detail"], "properties": { "grader": { "type": "string" }, "passed": { "type": "boolean" }, "detail": { "type": "string" } } } }
        }
      }
    },
    "summary": { "type": "object", "additionalProperties": false, "required": ["total", "passed", "failed", "abstained", "not_run"], "properties": { "total": { "type": "integer", "minimum": 1 }, "passed": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 }, "abstained": { "type": "integer", "minimum": 0 }, "not_run": { "type": "integer", "minimum": 0 } } }
  }
}
