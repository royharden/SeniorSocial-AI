# pnpm configuration (WP-001).

# SEC-050: CI installs with a frozen lockfile. pnpm defaults this to true on CI
# already; stating it here means a local `pnpm install` that would rewrite the
# lockfile fails loudly instead of quietly resolving something new. Use
# `pnpm install --no-frozen-lockfile` deliberately when you are adding a
# dependency, so the change shows up as an intentional act in the diff.
frozen-lockfile=true

# SEC-051 companion: never run a dependency's install scripts unless it is named
# in pnpm-workspace.yaml's onlyBuiltDependencies.
dangerously-allow-all-builds=false

# Deterministic, non-hoisted layout: a package can only import what it declares.
# Phantom dependencies are how a package "works" until the day it is built alone.
node-linker=isolated
strict-peer-dependencies=false
auto-install-peers=true
resolution-mode=highest

# The pnpm store must stay off OneDrive (compose-plan.md s5, harness notes).
# pnpm's Windows default (%LOCALAPPDATA%\pnpm\store) already satisfies this, so
# no store-dir is pinned here: hard-coding an absolute path would break the
# Linux CI runner and every other machine. Verify with `pnpm store path`.

engine-strict=true
